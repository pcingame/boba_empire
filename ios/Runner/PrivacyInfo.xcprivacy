<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>NSPrivacyTracking</key>
  <false/>
  <key>NSPrivacyTrackingDomains</key>
  <array>
    <!-- App không tự gọi network tới domain tracking nào — mọi request quảng
         cáo/tracking đều nằm trong SDK Google Mobile Ads (AdMob), SDK đó tự
         kèm PrivacyInfo.xcprivacy riêng (bundle trong pod google_mobile_ads),
         khai NSPrivacyTracking/NSPrivacyTrackingDomains của chính nó. Apple
         gộp manifest của app + mọi SDK khi build, nên app-level phải khai
         false/rỗng để nhất quán nội bộ (ITMS-91064: true bắt buộc domains
         không rỗng). ATT permission vẫn xin bình thường qua UMP (ad_bootstrap.dart)
         vì đó là quyền hệ thống, độc lập với khai báo manifest này. -->
  </array>
  <key>NSPrivacyCollectedDataTypes</key>
  <array/>
  <key>NSPrivacyAccessedAPITypes</key>
  <array>
    <dict>
      <key>NSPrivacyAccessedAPIType</key>
      <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
      <key>NSPrivacyAccessedAPITypeReasons</key>
      <array>
        <string>CA92.1</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
