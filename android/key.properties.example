# Mẫu cấu hình ký release. COPY file này thành `key.properties` (cùng thư mục)
# rồi điền giá trị thật. `key.properties` đã được .gitignore — KHÔNG commit.
#
# Tạo keystore trước:
#   keytool -genkey -v -keystore boba-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 -alias upload
#
# storeFile: đường dẫn tới file .jks (Windows dùng dấu / hoặc \\).

storePassword=CHANGEME
keyPassword=CHANGEME
keyAlias=upload
storeFile=C:/Users/24h/keys/boba-upload.jks
